{
  "datasets": [
    {
      "name": "txn_by_merchant",
      "displayName": "Transactions by Merchant Category",
      "queryLines": [
        "SELECT\n",
        "  merchant_category,\n",
        "  COUNT(*) AS transaction_count\n",
        "FROM\n",
        "  fraudwatch.silver.transactions\n",
        "GROUP BY\n",
        "  merchant_category\n",
        "ORDER BY\n",
        "  transaction_count DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "txn_by_minute",
      "displayName": "Transaction Count by Minute",
      "queryLines": [
        "SELECT\n",
        "  window_start,\n",
        "  transaction_count\n",
        "FROM\n",
        "  fraudwatch.gold.transaction_count_by_minute_tumbling_window\n",
        "ORDER BY\n",
        "  window_start"
      ]
    },
    {
      "name": "fraud_card_alerts_count",
      "displayName": "Fraud Card Alerts Count",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS fraud_card_alerts\n",
        "FROM\n",
        "  fraudwatch.gold.fraud_card_alerts"
      ]
    },
    {
      "name": "fraud_by_reason",
      "displayName": "Fraud Alerts by Reason Code",
      "queryLines": [
        "SELECT\n",
        "  reason_code,\n",
        "  COUNT(*) AS alert_count\n",
        "FROM\n",
        "  fraudwatch.gold.fraud_card_alerts\n",
        "GROUP BY\n",
        "  reason_code\n",
        "ORDER BY\n",
        "  alert_count DESC"
      ]
    },
    {
      "name": "intl_vs_domestic",
      "displayName": "International vs Domestic Transactions",
      "queryLines": [
        "SELECT\n",
        "  CASE\n",
        "    WHEN is_international THEN 'International'\n",
        "    ELSE 'Domestic'\n",
        "  END AS transaction_scope,\n",
        "  COUNT(*) AS transaction_count\n",
        "FROM\n",
        "  fraudwatch.silver.transactions\n",
        "GROUP BY\n",
        "  is_international"
      ]
    },
    {
      "name": "top_cities",
      "displayName": "Top Cities by Transaction Count",
      "queryLines": [
        "SELECT\n",
        "  city,\n",
        "  COUNT(*) AS transaction_count\n",
        "FROM\n",
        "  fraudwatch.silver.transactions\n",
        "GROUP BY\n",
        "  city\n",
        "ORDER BY\n",
        "  transaction_count DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "fraud_by_risk",
      "displayName": "Fraud Card Alerts by Risk Level",
      "queryLines": [
        "SELECT\n",
        "  risk_level,\n",
        "  COUNT(*) AS alert_count\n",
        "FROM\n",
        "  fraudwatch.gold.fraud_card_alerts\n",
        "GROUP BY\n",
        "  risk_level\n",
        "ORDER BY\n",
        "  alert_count DESC"
      ]
    },
    {
      "name": "limit_exceeded_count",
      "displayName": "Limit Exceeded Alerts Count",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS limit_exceeded_alerts\n",
        "FROM\n",
        "  fraudwatch.gold.transaction_alerts"
      ]
    },
    {
      "name": "recent_limit_alerts",
      "displayName": "Recent Limit Exceeded Alerts",
      "queryLines": [
        "SELECT\n",
        "  alert_id,\n",
        "  alert_timestamp,\n",
        "  customer_name,\n",
        "  customer_email,\n",
        "  ROUND(transaction_amount, 2) AS transaction_amount,\n",
        "  transaction_limit,\n",
        "  currency,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  payment_channel,\n",
        "  city,\n",
        "  status\n",
        "FROM\n",
        "  fraudwatch.gold.transaction_alerts\n",
        "ORDER BY\n",
        "  alert_timestamp DESC\n",
        "LIMIT 50"
      ]
    },
    {
      "name": "recent_fraud_alerts",
      "displayName": "Recent Fraud Card Alerts",
      "queryLines": [
        "SELECT\n",
        "  alert_id,\n",
        "  alert_timestamp,\n",
        "  customer_name,\n",
        "  customer_email,\n",
        "  card_number,\n",
        "  ROUND(amount, 2) AS amount,\n",
        "  currency,\n",
        "  merchant_name,\n",
        "  merchant_category,\n",
        "  transaction_city,\n",
        "  risk_level,\n",
        "  reason_code,\n",
        "  watch_type\n",
        "FROM\n",
        "  fraudwatch.gold.fraud_card_alerts\n",
        "ORDER BY\n",
        "  alert_timestamp DESC\n",
        "LIMIT 50"
      ]
    },
    {
      "name": "total_transactions",
      "displayName": "Total Transactions",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_transactions\n",
        "FROM\n",
        "  fraudwatch.silver.transactions"
      ]
    },
    {
      "name": "txn_by_channel",
      "displayName": "Transactions by Payment Channel",
      "queryLines": [
        "SELECT\n",
        "  payment_channel,\n",
        "  COUNT(*) AS transaction_count\n",
        "FROM\n",
        "  fraudwatch.silver.transactions\n",
        "GROUP BY\n",
        "  payment_channel\n",
        "ORDER BY\n",
        "  transaction_count DESC"
      ]
    },
    {
      "name": "total_volume",
      "displayName": "Total Volume",
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(amount) / 1000000, 2) AS total_volume_m\n",
        "FROM\n",
        "  fraudwatch.silver.transactions"
      ]
    }
  ],
